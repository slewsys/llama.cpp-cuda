#!/usr/bin/env bash
#
# Copyright © 2025 Revolution Robotics, Inc.
#
# SPDX-License-Identifier: MIT
#
# @(#) build-llama.cpp-cuda
#
# This script builds llama.cpp with CUDA and Intel cuBLAS support.
# Both the latest CUDA and Intel OneAPI hpc toolkit are installed as
# needed. In addition, the asdf version manager is installed as needed
# and used to install the latest Python 3.11.x.
#
: ${ASDF_CMD="${HOME}/bin/asdf"}
: ${AWK_CMD:='@AWK_CMD@'}
: ${CAT_CMD:='@CAT_CMD@'}
: ${CMAKE_CMD:='@CMAKE_CMD@'}
: ${ED_CMD:='@ED_CMD@'}
: ${GIT_CMD:='@GIT_CMD@'}
: ${GREP_CMD:='@GREP_CMD@'}
: ${MAKE_CMD:='@MAKE_CMD@'}
: ${NPROC_CMD:='@NPROC_CMD@'}
: ${PATCH_CMD:='@PATCH_CMD@'}
: ${PIP_CMD:="${HOME}/.asdf/shims/pip"}
: ${READLINK_CMD:='@READLINK_CMD@'}
: ${RM_CMD:='@RM_CMD@'}
: ${SORT_CMD:='@SORT_CMD@'}
: ${SUDO_CMD:='@SUDO_CMD@'}
: ${TEE_CMD:='@TEE_CMD@'}
: ${UPDATE_ALTERNATIVES_CMD:='@UPDATE_ALTERNATIVES_CMD@'}

: ${INSTALL_PREFIX:='/usr/local'}
: ${NVIDIA_CUDA_ROOT:='/usr/local/cuda'}
: ${INTEL_ONEAPI_ROOT:='/opt/intel/oneapi'}
: ${GPU_ARCHITECTURES:='@GPU_ARCHITECTURES@'}

# OS-agnstoic readlink for existent files/directories.
resolve-existing ()
{
    if $READLINK_CMD --version 2>&1 | $GREP_CMD -q 'coreutils'; then
        $READLINK_CMD -e "$@"
    else
        $READLINK_CMD -f N "$@"
    fi
}

set-alternatives ()
{
    local name=$1
    local path=$2

    if command -v "$UPDATE_ALTERNATIVES_CMD" >/dev/null; then
        if $UPDATE_ALTERNATIVES_CMD --list |
                $AWK_CMD '{ print $1 }' |
                $GREP_CMD -q "^${name}\>" &&
                test -f "$path"; then
            $SUDO_CMD -i $UPDATE_ALTERNATIVES_CMD --set "$name" "$path"
        fi
    fi
}

check-oneapi-env ()
{
    if test ."$ONEAPI_ROOT" = .''; then
        if test ! -d "$INTEL_ONEAPI_ROOT"; then
            $SUDO_CMD -i "${script_dir}/install-intel-oneapi-hpc" || return $?
        fi
        source "${INTEL_ONEAPI_ROOT}/setvars.sh"
    fi
}

check-cuda-env ()
{
    if test ! -d "${NVIDIA_CUDA_ROOT}/bin"; then
        $SUDO_CMD -i ${script_dir}/install-nvidia-cuda || return $?
    fi

    if ! $GREP_CMD -q cuda <<<$PATH; then
        export PATH=${NVIDIA_CUDA_ROOT}/bin:${PATH}
    fi

    if ! command -v nvcc >/dev/null; then
        echo "${script_name}: ${NVIDIA_CUDA_ROOT}: CUDA installation not found." >&2
        return 1
    fi
}

verify-python ()
{
    local version=$1

    pushd "${script_dir}" >/dev/null || return $?

    trap 'exit 1' 0 1 2 15 RETURN

    if ! command -v "$ASDF_CMD" >/dev/null && test -x "${HOME}/bin/asdf"; then
        export PATH=${PATH}:${HOME}/bin
    fi

    if command -v "$ASDF_CMD" >/dev/null; then
        if [[ ! ."$PATH" =~ ^\..*\.asdf/shims ]]; then
            export PATH=${HOME}/.asdf/shims:${PATH}
        fi

        python_available=$(
            $ED_CMD -s <($ASDF_CMD list) <<EOF
g/^python/1,.d
g/^[a-z]/.,\$d
,! $GREP_CMD "$version" | $SORT_CMD -V
p
Q
EOF
                        ) || return $?

        case "$python_available" in
            *'*'${version}*)
                : Nothing to do
                ;;
            *${version}*)
                if test -f "${script_dir}/.tool-versions"; then
                    $CP_CMD -a "${script_dir}/.tool-versions"{,."$script_name"} || return $?
                    $SED_CMD -i -e "s/^python.*/python${python_available}/" \
                             "${script_dir}/.tool-versions" || return $?
                else
                    echo "python${python_available}" >${script_dir}/.tool-versions
                fi
                ;;
            *)
                $ASDF_CMD plugin add python || return $?
                latest=$(eval $ASDF_CMD latest python "$version") || return $?
                $ASDF_CMD install python "$latest" || return $?
                $ASDF_CMD set python "$latest" || return $?
                ;;
        esac
    else
        ${script_dir}/install-asdf || return $?
        $ASDF_CMD plugin add python || return $?
        latest=$(eval $ASDF_CMD latest python "$version") || return $?
        $ASDF_CMD install python "$latest" || return $?
        $ASDF_CMD set python "$latest" || return $?
        $ASDF_CMD reshim python || return $?

        export PATH=${HOME}/.asdf/shims:${PATH}:${HOME}/bin
    fi

    popd >/dev/null || return $?

    trap - 0 1 2 15 RETURN
}

clone-repo ()
{
    local repo_url=$1
    local srcdir=$2

    if test -d "${srcdir}/.git"; then
        $GIT_CMD -C "$srcdir" reset --hard HEAD || return $?
        $GIT_CMD -C "$srcdir" pull --rebase || return $?
    else
        $INSTALL_CMD -d -m 0755 "${srcdir%/*}" || return $?
        $GIT_CMD -C "${srcdir%/*}" clone "$repo_url" "${srcdir##*/}" || return $?
    fi
}

patch-repo ()
{
    local srcdir=$1
    local patchdir=$2

    local up_to_date=''

    up_to_date=$(
        $GIT_CMD -C "$srcdir" log \
                 --pretty=reference --grep 'Update Python scripts.'
           ) || return $?

    if test ."$up_to_date" != .''; then
        return 0
    fi

    local patchfile=''
    local subdir=''

    for patchfile in "${patchdir}/"*.diff; do
        subdir=$($ED_CMD -e '/^+++ /s;;;' -e 's;/[^/]*$;;p' "$patchfile") || return $?
        $PATCH_CMD -d "${srcdir}/${subdir}" <"$patchfile" || return $?
    done

    $CAT_CMD >&2 <<'EOF'
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! Enter git credentials for commit: 'Update Python scripts.': !!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
EOF
    $GIT_CMD -C "$srcdir" commit -a -m 'Update Python scripts.'
}

build-llama.cpp ()
{
    local srcdir=$1
    local install_prefix=$2
    local gpu_architectures=$3

    local cmake_cuda_architectures=''

    if test ."$gpu_architectures" != .''; then
        cmake_cuda_architectures=-DCMAKE_CUDA_ARCHITECTURES="$gpu_architectures"
    fi

    local builddir=${srcdir}/build

    $RM_CMD -rf "$builddir" || return $?
    export CC=/usr/bin/gcc-15 \
           CXX=/usr/bin/g++-15
    $CMAKE_CMD \
        -S "$srcdir" \
        -B "$builddir" \
        -DCMAKE_INSTALL_PREFIX="${install_prefix}" \
        -DCMAKE_INSTALL_RPATH="${install_prefix}/lib64;${NVIDIA_CUDA_ROOT}/targets/x86_64-linux/lib;${ONEAPI_ROOT}/compiler/latest/lib;${ONEAPI_ROOT}/mkl/latest/lib" \
        -DGGML_CUDA=ON \
        $cmake_cuda_architectures \
        -DGGML_BLAS=ON \
        -DGGML_BLAS_VENDOR=Intel10_64lp \
        -DCMAKE_C_COMPILER=icx \
        -DCMAKE_CXX_COMPILER=icpx \
        || return $?

    $MAKE_CMD -C "$builddir" -j$($NPROC_CMD) VERBOSE=1 |&
        $TEE_CMD "${script_dir}/build.OUT" || return $?
}

if test ."$0" = ."${BASH_SOURCE[0]}"; then
    declare script=''
    declare script_dir=''
    declare script_name=''

    script=$(resolve-existing "$0") || exit $?
    script_name=${script##*/}
    script_dir=${script%/*}

    if (( EUID == 0 )); then
        echo "${script_name}: This script must not be run by user root." >&2
        exit 1
    fi

    declare top_srcdir=''

    top_srcdir=$(
        cd "$script_dir" && $GIT_CMD rev-parse --show-toplevel
              ) || true

    declare abs_srcdir=${1:-"$top_srcdir"}
    declare install_prefix=${2:-"$INSTALL_PREFIX"}
    declare gpu_architectures=${3:-"$GPU_ARCHITECTURES"}

    declare llama_repo_url='https://github.com/ggml-org/llama.cpp.git'
    declare llama_srcdir=${script_dir}/src/llama.cpp
    declare llama_patchdir=${abs_srcdir}/patches
    declare py_version='3\.11'
    declare top_srcdir=''

    top_srcdir=$($GIT_CMD rev-parse --show-toplevel) || exit $?

    echo "Building llama.cpp with CUDA and Intel cuBLAS support" >&2

    set-alternatives gcc /usr/bin/x86_64-linux-gnu-gcc-15 || exit $?
    set-alternatives g++ /usr/bin/x86_64-linux-gnu-g++-15 || exit $?
    set-alternatives gfortran /usr/bin/x86_64-linux-gnu-gfortran-15 || exit $?
    # set-alternatives gcc /usr/bin/x86_64-linux-gnu-gcc-16 || exit $?
    # set-alternatives g++ /usr/bin/x86_64-linux-gnu-g++-16 || exit $?
    # set-alternatives gfortran /usr/bin/x86_64-linux-gnu-gfortran-16 || exit $?
    # set-alternatives cuda /usr/local/cuda-13.2 || exit $?
    set-alternatives cuda /usr/local/cuda-13.3 || exit $?
    check-oneapi-env || exit $?
    check-cuda-env || exit $?
    verify-python "$py_version" || exit $?
    clone-repo "$llama_repo_url" "$llama_srcdir" || exit $?
    patch-repo "$llama_srcdir" "$llama_patchdir" || exit $?
    build-llama.cpp "$llama_srcdir" "$install_prefix" "$gpu_architectures" || exit $?
fi
