#!/usr/bin/env bash
#
# Copyright © 2025 Revolution Robotics, Inc.
#
# SPDX-License-Identifier: MIT
#
# @(#) install-llama.cpp-cuda
#
# This script installs llama.cpp with CUDA and Intel cuBLAS support.
#
: ${ASDF_CMD="${HOME}/bin/asdf"}
: ${AWK_CMD:='@AWK_CMD@'}
: ${CAT_CMD:='@CAT_CMD@'}
: ${CMAKE_CMD:='@CMAKE_CMD@'}
: ${ED_CMD:='@ED_CMD@'}
: ${GIT_CMD:='@GIT_CMD@'}
: ${GREP_CMD:='@GREP_CMD@'}
: ${INSTALL_CMD:='@INSTALL_CMD@'}
: ${MAKE_CMD:='@MAKE_CMD@'}
: ${PATCH_CMD:='@PATCH_CMD@'}
: ${PIP_CMD:='@PIP_CMD@'}
: ${PYTHON_CMD:='@PYTHON_CMD@'}
: ${READLINK_CMD:='@READLINK_CMD@'}
: ${RM_CMD:='@RM_CMD@'}
: ${SORT_CMD:='@SORT_CMD@'}
: ${SUDO_CMD:='@SUDO_CMD@'}
: ${UPDATE_ALTERNATIVES_CMD:='@UPDATE_ALTERNATIVES_CMD@'}

: ${INSTALL_PREFIX:='/usr/local'}
: ${NVIDIA_CUDA_ROOT:='/usr/local/cuda'}
: ${INTEL_ONEAPI_ROOT:='/opt/intel/oneapi'}

# OS-agnstoic readlink for existent files/directories.
resolve-existing ()
{
    if $READLINK_CMD --version 2>&1 | $GREP_CMD -q 'coreutils'; then
        $READLINK_CMD -e "$@"
    else
        $READLINK_CMD -f N "$@"
    fi
}

set-alternatives ()
{
    local name=$1
    local path=$2

    if command -v "$UPDATE_ALTERNATIVES_CMD" >/dev/null; then
        if $UPDATE_ALTERNATIVES_CMD --list |
                $AWK_CMD '{ print $1 }' |
                $GREP_CMD -q "^${name}\>" &&
                test -f "$path"; then
            $SUDO_CMD -i $UPDATE_ALTERNATIVES_CMD --set "$name" "$path"
        fi
    fi
}

check-oneapi-env ()
{
    if test ."$ONEAPI_ROOT" = .''; then
        if test ! -d "$INTEL_ONEAPI_ROOT"; then
            $SUDO_CMD -i "${script_dir}/install-intel-oneapi-hpc" || return $?
        fi
        source "${INTEL_ONEAPI_ROOT}/setvars.sh"
    fi
}

check-cuda-env ()
{
    if test ! -d "${NVIDIA_CUDA_ROOT}/bin"; then
        $SUDO_CMD -i "${script_dir}/install-nvidia-cuda" || return $?
    fi

    if ! $GREP_CMD -q cuda <<<$PATH; then
        export PATH=${NVIDIA_CUDA_ROOT}/bin:${PATH}
    fi

    if ! command -v nvcc >/dev/null; then
        echo "${script_name}: ${NVIDIA_CUDA_ROOT}: CUDA installation not found." >&2
        return 1
    fi
}

verify-python ()
{
    local version=$1

    pushd "${script_dir}" >/dev/null || return $?

    trap 'exit 1' 0 1 2 15 RETURN

    if ! command -v "$ASDF_CMD" >/dev/null && test -x "${HOME}/bin/asdf"; then
        export PATH=${PATH}:${HOME}/bin
    fi

    if command -v "$ASDF_CMD" >/dev/null; then
        if [[ ! ."$PATH" =~ ^\..*\.asdf/shims ]]; then
            export PATH=${HOME}/.asdf/shims:${PATH}
        fi

        python_available=$(
            $ED_CMD -s <($ASDF_CMD list) <<EOF
g/^python/1,.d
g/^[a-z]/.,\$d
,! $GREP_CMD "$version" | $SORT_CMD -V
p
Q
EOF
                        ) || return $?

        case "$python_available" in
            *'*'${version}*)
                : Nothing to do
                ;;
            *${version}*)
                if test -f "${script_dir}/.tool-versions"; then
                    $CP_CMD -a "${script_dir}/.tool-versions"{,."$script_name"} || return $?
                    $SED_CMD -i -e "s/^python.*/python${python_available}/" \
                             "${script_dir}/.tool-versions" || return $?
                else
                    echo "python${python_available}" >${script_dir}/.tool-versions
                fi
                ;;
            *)
                $ASDF_CMD plugin add python || return $?
                latest=$(eval $ASDF_CMD latest python "$version") || return $?
                $ASDF_CMD install python "$latest" || return $?
                $ASDF_CMD set python "$latest" || return $?
                ;;
        esac
    else
        ${script_dir}/install-asdf || return $?
        $ASDF_CMD plugin add python || return $?
        latest=$(eval $ASDF_CMD latest python "$version") || return $?
        $ASDF_CMD install python "$latest" || return $?
        $ASDF_CMD set python "$latest" || return $?
        $ASDF_CMD reshim python || return $?

        export PATH=${HOME}/.asdf/shims:${PATH}:${HOME}/bin
    fi

    popd >/dev/null || return $?

    trap - 0 1 2 15 RETURN
}

install-llama.cpp ()
{
    local srcdir=$1

    local builddir=${srcdir}/build

    if test ! -d "$builddir"; then
        echo "${script_name}: ${builddir}: No such file or directory." >&2
        echo "${script_name}: Please build llama.cpp first." >&2
        return 1
    fi

    $SUDO_CMD -i $MAKE_CMD -C "$builddir" install || return $?
}

install-scripts ()
{
    local srcdir=$1

    local py_site_packages_dir=''

    py_site_packages_dir=$($PYTHON_CMD -c 'import site; print(site.getsitepackages()[0])') || return $?

    $PIP_CMD install "${srcdir}/gguf-py" || return $?
    $INSTALL_CMD -d -m 0755 "${install_prefix}/bin" || return $?
    $INSTALL_CMD -d -m 0755 "${srcdir}/conversion"  "$py_site_packages_dir"|| return $?
}

if test ."$0" = ."${BASH_SOURCE[0]}"; then
    declare script=''
    declare script_dir=''
    declare script_name=''

    script=$(resolve-existing "$0") || exit $?
    script_name=${script##*/}
    script_dir=${script%/*}

    if (( EUID == 0 )); then
        echo "${script_name}: This script must not be run by user root." >&2
        exit 1
    fi

    echo "Installing llama.cpp with CUDA and Intel cuBLAS support" >&2

    declare top_srcdir=''

    top_srcdir=$(
        cd "$script_dir" && $GIT_CMD rev-parse --show-toplevel
              ) || true

    declare abs_srcdir=${1:-"$top_srcdir"}
    declare install_prefix=${2:-"$INSTALL_PREFIX"}

    declare llama_srcdir=${script_dir}/src/llama.cpp
    declare py_version='3\.14'

    set-alternatives gcc /usr/bin/x86_64-linux-gnu-gcc-15 || exit $?
    set-alternatives g++ /usr/bin/x86_64-linux-gnu-g++-15 || exit $?
    set-alternatives gfortran /usr/bin/x86_64-linux-gnu-gfortran-15 || exit $?
    # set-alternatives gcc /usr/bin/x86_64-linux-gnu-gcc-16 || exit $?
    # set-alternatives g++ /usr/bin/x86_64-linux-gnu-g++-16 || exit $?
    # set-alternatives gfortran /usr/bin/x86_64-linux-gnu-gfortran-16 || exit $?
    # set-alternatives cuda /usr/local/cuda-13.2 || exit $?
    set-alternatives cuda /usr/local/cuda-13.3 || exit $?
    check-oneapi-env || exit $?
    check-cuda-env || exit $?
    verify-python "$py_version" || exit $?
    install-llama.cpp "$llama_srcdir" || exit $?
    install-scripts "$llama_srcdir" "$install_prefix" || exit $?
fi
